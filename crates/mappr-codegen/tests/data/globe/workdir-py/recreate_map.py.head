#!/usr/bin/env python3
# Made with PyMappr 1.34.0 - https://github.com/CalebHendren/PyMappr
"""Recreate the PyMappr map "globe" outside PyMappr.

Generated by PyMappr 1.34.0 from pre-made function templates and
the map's saved settings

Just run it: open this file in an IDE (PyCharm, VS Code, ...) and click
Run, or `python recreate_map.py` in a terminal. If a package it needs
(pandas, geopandas, matplotlib) is missing, it prints the pip command to
install it - or run `python recreate_map.py --install-deps` to have it
installed for you. The map data is downloaded from Natural Earth and cached
in naturalearth_cache/ next to this script.

Output:  map.png (also opens an interactive window).

Your point data is in the data/ folder as CSV - edit or replace those files
to update the map.
"""
# Projection: Globe (Orthographic)

# ------------------------- map configuration (from PyMappr) -------------------------

MAP_CRS = '+proj=ortho +lat_0=0.0 +lon_0=0.0 +x_0=0 +y_0=0 +datum=WGS84 +units=m +no_defs'  # proj4 string, or None for plain lon/lat degrees
PROJ = {'bounds': (-6378127.285544, 6378127.285544, -6356742.567109, 6356742.567109), 'max_lat': 90.0, 'min_lat': -90.0, 'lon_0': 0.0, 'lon_halfspan': 180.0, 'hemisphere': True}
CLIP_CAP = (0.0, 0.0, 88.0)  # (lon0, lat0, radius) visible cap for the globe, else None
VIEW = (-6378137.0, 6378137.0, -6378137.0, 6378137.0)  # axis limits in map coordinates (x0, x1, y0, y1)
ZOOM = -0.0  # log2(world width / view width), used for culling
FIGSIZE = (9.0, 9.037)  # inches; the app canvas geometry
MARGINS = (0.01, 0.012, 0.99, 0.988)  # axes box as figure fractions (l, b, r, t)
BASEMAP = 'simple'  # raster basemap mode ("simple" = none)
GRATICULE = {'interval': 10.0, 'labels': False}
COMPASS = {'show': False, 'position': 'upper right', 'style': 'arrow', 'size': 1.0, 'color': '#1a1a1a'}
SCALE_BAR = {'show': False, 'units': 'km', 'position': 'lower left', 'style': 'segmented', 'length_mode': 'auto', 'fixed_length': None, 'segments': 4, 'width': 0.22, 'fontsize': 8.0, 'color': '#1a1a1a', 'draggable': False, 'anchor_x': None, 'anchor_y': None}
POINT_ALPHA = 1.0
POINT_EDGE = {'color': '#000000', 'width': 0.6}  # outline around filled markers
DPI = 600
OUTPUT_FILE = "map.png"

# Natural Earth layers enabled in PyMappr, with the renderer's true draw
# order (z). A filter is (column, kept values, keep?) applied after download.
LAYERS = [
    # PyMappr layer: ocean_fill
    {'name': 'ocean', 'category': 'physical', 'scale': '110m', 'kind': 'fill', 'z': 0.3, 'color': '#dcdcdc', 'edgecolor': 'none', 'width': 0.0, 'alpha': 1.0},
    # PyMappr layer: countries
    {'name': 'admin_0_countries', 'category': 'cultural', 'scale': '110m', 'kind': 'line', 'z': 1.6, 'color': '#000000', 'width': 0.8, 'linestyle': 'solid'},
]

# Map label layers (country/city/... names), like the app draws them.
LABEL_LAYERS = [
]

# One entry per dataset. lon_col/lat_col name the coordinate columns
# (None = auto-detect by column name).
# label_map renames groups for the legend; 'styles' maps each group to its
# point style, in render order (open = outline-only marker).
DATASETS = [
    # originally imported from: C:\PyCharm\PyMappr\sample_data\south_america_beetles.csv
    {
        'name': 'south_america_beetles.csv',
        'path': 'data/south_america_beetles.csv',
        'inline_data': None,
        'lon_col': 'Longitude',
        'lat_col': 'Latitude',
        'group_col': 'Genus',
        'color_col': None,
        'symbol_col': None,
        'default_label': 'All points',
        'label_map': {'Eleusis': 'Eleusis', 'Xanthopygus': 'Xanthopygus', 'Plociopterus': 'Plociopterus'},
        'open_col': None,
