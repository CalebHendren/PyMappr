            'Plociopterus': {'color': '#808080', 'marker': '^', 'size': 30.0, 'open': False, 'fill': None},
        },
    },
]

LEGEND_SECTIONS = None  # plain legend: one row per style, in DATASETS

# Legend rows for the plain legend, in order (None = every style, in DATASETS order).
LEGEND_ROWS = ['Eleusis', 'Plociopterus', 'Xanthopygus']

# The legend's last row: what the open symbols mark (None = no open symbols).
OPEN_NOTE = None

LEGEND = {'show': True, 'title': '', 'show_title': False, 'location': 'best', 'hierarchy': 'auto', 'order': 'az', 'counts': False, 'count_format': '(n)', 'blank_label': '(blank)', 'section_titles': True, 'title_separator': ' / ', 'dataset_prefix': True, 'empty_groups': False, 'indent': 3, 'bold_groups': True, 'group_spacer': True, 'group_swatch': 'circle', 'symbol_swatch_color': '#555555', 'columns': 1, 'label_spacing': 0.5, 'column_spacing': 2.0, 'handle_text_pad': 0.8, 'handle_length': 2.0, 'border_pad': 0.4, 'marker_scale': 1.0, 'frame': True, 'frame_color': '#ffffff', 'frame_alpha': 1.0, 'frame_edge_color': '#000000', 'frame_width': 0.5, 'rounded': False, 'shadow': False, 'fontsize': 9.0, 'title_fontsize': 10.0, 'font_family': '', 'label_color': '#000000', 'title_color': '#000000', 'label_bold': False, 'label_italic': True, 'label_underline': False, 'title_bold': True, 'title_italic': False, 'title_underline': False, 'title_align': 'center'}

