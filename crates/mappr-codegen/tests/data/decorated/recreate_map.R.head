# Made with PyMappr 1.34.0 - https://github.com/CalebHendren/PyMappr
# Recreate the PyMappr map "Decorated \"map\"" outside PyMappr.
#
# Generated by PyMappr 1.34.0 from pre-made function templates and
# the map's saved settings - deterministically. The layers, colors, view,
# and styling mirror PyMappr's renderer as closely as sf + ggplot2 allow.
#
# Just run it: open this file in RStudio and click Source, or run
# `Rscript recreate_map.R` in a terminal. If sf or ggplot2 is missing it
# stops with the install.packages() line to run - or run
# `Rscript recreate_map.R --install-deps` to have them installed for you.
# The map data is downloaded from Natural Earth and cached in
# naturalearth_cache/ next to this script.
#
# Output: map.png
#
# Your point data is embedded below in DATASETS, so this single file is
# self-contained.
# The satellite basemap needs the terra and tidyterra packages; without
# them the script draws the vector map only.
#
# Projection: Robinson
# Shown in PyMappr but NOT reproduced by this script:
#   - Biodiversity hotspots overlay (Conservation International data, not Natural Earth)
#   - Terrestrial ecoregions overlay (RESOLVE data, not Natural Earth)
#   - Map labels (country/city/... name placement)
#   - Underlined legend text (ggplot2 element_text has no underline; bold/italic are applied)
#   - Legend swatch width (no ggplot2 equivalent)
#   - Rounded legend corners (no ggplot2 equivalent)
#   - The legend's drop shadow (no ggplot2 equivalent)

ensure_packages <- function(pkgs) {
  missing <- pkgs[!vapply(pkgs, requireNamespace, logical(1),
                          quietly = TRUE)]
  if (length(missing) == 0) return(invisible())
  command <- sprintf(
    'install.packages(c(%s), repos = "https://cloud.r-project.org")',
    paste0('"', missing, '"', collapse = ", "))
  if (!("--install-deps" %in% commandArgs(trailingOnly = TRUE))) {
    stop("This script needs ", paste(missing, collapse = ", "),
         ". Install with:
    ", command,
         "
or run it with Rscript ... --install-deps to install them ",
         "automatically.", call. = FALSE)
  }
  message("Installing missing packages: ", paste(missing, collapse = ", "))
  install.packages(missing, repos = "https://cloud.r-project.org")
}
ensure_packages(c("sf", "ggplot2"))

library(sf)
library(ggplot2)

# ------------------------- map configuration (from PyMappr) -------------------------

MAP_CRS <- "+proj=robin +lon_0=0 +datum=WGS84 +units=m +no_defs"
VIEW <- c(-8500000.0, -3000000.0, -6000000.0, 1500000.0)  # axis limits in map coordinates (x0, x1, y0, y1)
CLIP_CAP <- NULL  # (lon0, lat0, radius) visible cap for the globe, else NULL
MAX_LAT <- 90.0  # the projection's usable latitude band
MIN_LAT <- -90.0
LON_0 <- 0.0  # central meridian, and how far either side is usable
LON_HALFSPAN <- 180.0
PROJ_X <- c(-17003189.700318, 17003189.700318)  # the world's x range, for wrapped copies
HEMISPHERE <- FALSE  # a globe: only the near side is drawn
FIGSIZE <- c(9.0, 12.143)  # inches; the app canvas geometry
GEOGRAPHIC <- FALSE  # plain lon/lat degrees?
BASEMAP <- "simple"  # raster basemap mode ("simple" = none)
GRID_INTERVAL <- 5.0  # graticule spacing in degrees (NULL = off)
GRID_LABELS <- TRUE
POINT_ALPHA <- 0.85
POINT_STROKE <- 0.6  # outline width of filled markers, in points
POINT_EDGE_COLOR <- "#000000"
