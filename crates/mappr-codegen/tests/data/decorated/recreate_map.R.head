      "Eleusis" = "Eleusis (18, 36%)",
      "Xanthopygus" = "Xanthopygus (16, 32%)",
      "Plociopterus" = "Plociopterus (16, 32%)"
    )
  )
)

# Legend key -> style, in render order. A key is the legend label, with
# " [n]" added where dataset n repeats a label another dataset already uses
# (STYLE_LABELS holds those keys' labels). Fillable shapes (21-25) carry
# the app's marker outline; sizes approximate PyMappr's marker areas and
# strokes are outline widths in points.
STYLE_COLORS <- c(
  "Eleusis (18, 36%)" = "#000000",
  "Xanthopygus (16, 32%)" = "#000000",
  "Plociopterus (16, 32%)" = "#000000"
)
STYLE_FILLS <- c(
  "Eleusis (18, 36%)" = "#000000",
  "Xanthopygus (16, 32%)" = "#ffffff",
  "Plociopterus (16, 32%)" = "#808080"
)
STYLE_SHAPES <- c(
  "Eleusis (18, 36%)" = 21,
  "Xanthopygus (16, 32%)" = 22,
  "Plociopterus (16, 32%)" = 24
)
STYLE_SIZES <- c(
  "Eleusis (18, 36%)" = 1.93,
  "Xanthopygus (16, 32%)" = 1.93,
  "Plociopterus (16, 32%)" = 1.93
)
STYLE_STROKES <- c(
  "Eleusis (18, 36%)" = 0.6,
  "Xanthopygus (16, 32%)" = 0.6,
  "Plociopterus (16, 32%)" = 0.6
)
STYLE_LABELS <- c()

